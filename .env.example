# Supabase — public, browser-safe values only.
# Get these from your Supabase project: Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Never put the Supabase service role key here — it must never reach the
# browser. Service-role-level operations belong in Supabase Edge Functions,
# where secrets are configured separately (see README, Phase 2).
